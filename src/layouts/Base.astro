---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Matteo Scurati — digital identity of a developer & AI researcher"
    />
    <meta name="theme-color" content="#0a0a0f" />

    <!-- Open Graph -->
    <meta property="og:title" content="Matteo Scurati" />
    <meta property="og:description" content="Developer & AI Researcher" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Matteo Scurati",
        "url": "https://matteoscurati.dev",
        "jobTitle": "Developer & AI Researcher"
      }
    </script>

    <title>Matteo Scurati — building autonomous systems</title>
  </head>
  <body class="bg-bg text-text min-h-screen font-mono">
    <a href="#main" class="skip-link">Skip to content</a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
